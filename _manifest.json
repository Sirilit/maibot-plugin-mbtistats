{
  "manifest_version": 2,
  "version": "0.2.0",
  "name": "MBTI Stats",
  "description": "统计群成员的 MBTI 类型与特质分布，并把结果交给 AI 决定如何发送。",
  "author": {
    "name": "Sirilit",
    "url": "https://github.com/Siridelta"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Siridelta/maibot-plugin-mbtistats",
    "homepage": "https://github.com/Siridelta/maibot-plugin-mbtistats",
    "documentation": "https://github.com/Siridelta/maibot-plugin-mbtistats#readme",
    "issues": "https://github.com/Siridelta/maibot-plugin-mbtistats/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.image",
    "render.html2png",
    "api.call",
    "chat.get_stream_by_group_id",
    "chat.open_session",
    "maisaka.context.append",
    "maisaka.proactive.trigger",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "sirilit.mbtistats"
}
